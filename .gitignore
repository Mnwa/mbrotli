/target
.idea
.claude
Cargo.lock
specifications

# AFL crash and queue directories are local artifacts.
fuzz/afl/findings/
fuzz/afl/target/
fuzz/afl/artifacts/
# Seeds are materialised from the vendored Brotli test data.
fuzz/afl/seeds/
# The fuzz package pins its dependencies so a campaign is reproducible; the
# bare `Cargo.lock` rule above would otherwise swallow it.
!fuzz/afl/Cargo.lock

# The independent implementation comparison owns its dependency pins and output.
benchmarks/comparison/target/
benchmarks/comparison/__pycache__/
!benchmarks/comparison/Cargo.lock
